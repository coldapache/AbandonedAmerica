# Claude Code local config
.claude/

# Playwright MCP temp files
.playwright-mcp/

# Python
__pycache__/
*.pyc

# Reorganized scratch space — research scripts, raw images, intermediate
# data, and Street View screenshots. Anything an agent generates during a
# batch addition or enrichment run lives here and stays out of git.
# See temp/README.md for layout.
temp/

# Reference source datasets (kept locally, too large for repo)
sources/data/*.csv
sources/data/*.xlsx
sources/data/*.json

# Catch-all safety net for stray artifacts at repo root.
# `!`-rules below re-include the files we DO want tracked.
/*.jpg
/*.jpeg
/*.png
/*.gif
/*.json
/*.txt
/*.log
/*.xlsx
/*.xls
/*.html
/*.csv
/*.py
!/index.html
!/server.py
!/Abandoned America - Abandoned or Unused Properties.csv
